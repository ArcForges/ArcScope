<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ArcScope</AssemblyName>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ArcForges.Foundation" />
    <PackageReference Include="ArcForges.Application.Abstractions" />
    <PackageReference Include="ArcForges.Native.Image" />
    <!-- This staged producer has one RID. Retain its guard only when that runtime is selected. -->
    <PackageReference Include="ArcForges.Native.Image.Runtime.win-x64" GeneratePathProperty="true" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="ArcForges.Contracts.LocalRpc.Scope" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <ProjectReference Include="../ArcForges.ArcScope.Core/ArcForges.ArcScope.Core.csproj" />
    <PackageReference Include="ArcForges.Contracts.PublicApi" GeneratePathProperty="true" />
    <EmbeddedResource Include="../../eng/version-sources.json" LogicalName="ArcScope.VersionSources" />
    <EmbeddedResource Include="packages.lock.json" LogicalName="ArcScope.PackageLock" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/source.json" LogicalName="ArcScope.ContractsSource" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/build-identity.json" LogicalName="ArcScope.ContractsIdentity" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/contracts.binpb" LogicalName="ArcScope.ContractsDescriptor" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/http/v1/browser.schema.json" LogicalName="ArcScope.ContractsSchema.public/http/v1/browser.schema.json" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/http/v1/native-auth.schema.json" LogicalName="ArcScope.ContractsSchema.public/http/v1/native-auth.schema.json" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/http/v1/policy-body.schema.json" LogicalName="ArcScope.ContractsSchema.public/http/v1/policy-body.schema.json" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/http/v1/schema.json" LogicalName="ArcScope.ContractsSchema.public/http/v1/schema.json" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/http/v1/signed-formats.schema.json" LogicalName="ArcScope.ContractsSchema.public/http/v1/signed-formats.schema.json" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/proto/arcforges/catalog/v1/catalog.proto" LogicalName="ArcScope.ContractsSchema.public/proto/arcforges/catalog/v1/catalog.proto" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/proto/arcforges/foundation/v1/foundation.proto" LogicalName="ArcScope.ContractsSchema.public/proto/arcforges/foundation/v1/foundation.proto" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/proto/arcforges/hello/v1/hello.proto" LogicalName="ArcScope.ContractsSchema.public/proto/arcforges/hello/v1/hello.proto" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/proto/arcforges/publicapi/v1/application.proto" LogicalName="ArcScope.ContractsSchema.public/proto/arcforges/publicapi/v1/application.proto" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/proto/arcforges/publicapi/v1/chat.proto" LogicalName="ArcScope.ContractsSchema.public/proto/arcforges/publicapi/v1/chat.proto" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/proto/arcforges/publicapi/v1/commerce.proto" LogicalName="ArcScope.ContractsSchema.public/proto/arcforges/publicapi/v1/commerce.proto" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/proto/arcforges/publicapi/v1/connector.proto" LogicalName="ArcScope.ContractsSchema.public/proto/arcforges/publicapi/v1/connector.proto" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/proto/arcforges/publicapi/v1/content.proto" LogicalName="ArcScope.ContractsSchema.public/proto/arcforges/publicapi/v1/content.proto" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/proto/arcforges/publicapi/v1/descriptors.proto" LogicalName="ArcScope.ContractsSchema.public/proto/arcforges/publicapi/v1/descriptors.proto" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/proto/arcforges/publicapi/v1/export.proto" LogicalName="ArcScope.ContractsSchema.public/proto/arcforges/publicapi/v1/export.proto" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/proto/arcforges/publicapi/v1/identity.proto" LogicalName="ArcScope.ContractsSchema.public/proto/arcforges/publicapi/v1/identity.proto" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/proto/arcforges/publicapi/v1/inprocess-values.proto" LogicalName="ArcScope.ContractsSchema.public/proto/arcforges/publicapi/v1/inprocess-values.proto" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/proto/arcforges/publicapi/v1/scope.proto" LogicalName="ArcScope.ContractsSchema.public/proto/arcforges/publicapi/v1/scope.proto" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/proto/arcforges/publicapi/v1/support.proto" LogicalName="ArcScope.ContractsSchema.public/proto/arcforges/publicapi/v1/support.proto" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/proto/arcforges/publicapi/v1/sync.proto" LogicalName="ArcScope.ContractsSchema.public/proto/arcforges/publicapi/v1/sync.proto" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/proto/arcforges/publicapi/v1/transfer.proto" LogicalName="ArcScope.ContractsSchema.public/proto/arcforges/publicapi/v1/transfer.proto" />
    <EmbeddedResource Include="$(PkgArcForges_Contracts_PublicApi)/schemas/public/proto/arcforges/simulation/v1/simulation.proto" LogicalName="ArcScope.ContractsSchema.public/proto/arcforges/simulation/v1/simulation.proto" />
  </ItemGroup>
  <PropertyGroup>
    <LicenceBoundary>AGPL</LicenceBoundary>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Content Include="$(PkgArcForges_Native_Image_Runtime_win-x64)/licenses/**/*" Link="third-party/native-image/licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgArcForges_Native_Image_Runtime_win-x64)/provenance/**/*" Link="third-party/native-image/provenance/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgArcForges_Native_Image_Runtime_win-x64)/recipes/**/*" Link="third-party/native-image/recipes/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgArcForges_Native_Image_Runtime_win-x64)/NOTICE.md;$(PkgArcForges_Native_Image_Runtime_win-x64)/sbom.json;$(PkgArcForges_Native_Image_Runtime_win-x64)/native-manifest.json;$(PkgArcForges_Native_Image_Runtime_win-x64)/build-identity.json" Link="third-party/native-image/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="$(PkgArcForges_Native_Image_Runtime_win-x64)/buildTransitive/ArcForges.Native.Image.Runtime.win-x64.targets" Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
</Project>
